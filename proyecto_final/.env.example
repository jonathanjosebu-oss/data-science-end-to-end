# Copia este archivo a .env (excluido de Git) y completa tus credenciales.
# SNOWFLAKE_ACCOUNT es el identificador antes de ".snowflakecomputing.com".
SNOWFLAKE_ACCOUNT=your-organization-your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_ROLE=your-role
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=REPORT_QSRR_DB
SNOWFLAKE_SCHEMA=RAW

# UI/API de Kestra (basic auth). KESTRA_USER debe ser un email.
KESTRA_USER=admin@kestra.local
KESTRA_PASSWORD=CHANGE_ME_Kestra1

MLFLOW_TRACKING_URI=http://localhost:5000
RANDOM_STATE=42
# Opcional: solo para el benchmark con LLM del PSet 3.
GEMINI_API_KEY=
