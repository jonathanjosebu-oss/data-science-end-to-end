# Copy this file to .env and fill in your Snowflake connection details.
# SNOWFLAKE_ACCOUNT is the account identifier from your Snowflake URL,
# without ".snowflakecomputing.com".
SNOWFLAKE_ACCOUNT=your-organization-your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_ROLE=your-role
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=REPORT_QSRR_DB
SNOWFLAKE_SCHEMA=RAW
